{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "/bin/sh scripts/run-agent-log-hook.sh cursor",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "/bin/sh scripts/run-agent-log-hook.sh cursor",
        "timeout": 5
      }
    ],
    "afterAgentResponse": [
      {
        "command": "/bin/sh scripts/run-agent-log-hook.sh cursor",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "/bin/sh scripts/run-agent-log-hook.sh cursor",
        "timeout": 5
      }
    ]
  }
}
